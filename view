local function refreshPlayerList()
    for _, child in ipairs(PlayersHolder:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        local pBtn = Instance.new("TextButton")
        pBtn.Size = UDim2.new(1, -8, 0, 24)
        pBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        pBtn.BorderSizePixel = 0
        if p.DisplayName ~= p.Name then
            pBtn.Text = p.DisplayName .. "  @" .. p.Name
        else
            pBtn.Text = p.Name
        end
        pBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        pBtn.Font = Enum.Font.Gotham
        pBtn.TextSize = 11
        pBtn.TextTruncate = Enum.TextTruncate.AtEnd
        pBtn.Parent = PlayersHolder
        makeCorner(pBtn, 4)
        pBtn.MouseButton1Click:Connect(function()
            selectedPlayer = p
            SelectPlayerBtn.Text = "اللاعب المحدد: " .. p.Name
            PlayersHolder.Visible = false
            PlayersHolder.CanvasPosition = Vector2.new(0, 0)
        end)
    end
    task.defer(function()
        PlayersHolder.CanvasSize = UDim2.new(
            0,
            0,
            0,
            PlayersListLayout.AbsoluteContentSize.Y + 8
        )
    end)
end

SelectPlayerBtn.MouseButton1Click:Connect(function()
    PlayersHolder.Visible = not PlayersHolder.Visible
    if PlayersHolder.Visible then
        refreshPlayerList()
    end
end)

Players.PlayerAdded:Connect(function()
    if PlayersHolder.Visible then
