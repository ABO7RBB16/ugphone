IdBtn.MouseButton1Click:Connect(function()
    local TargetID = tonumber(IdBox.Text)
    if TargetID then
        local oldIndex
        oldIndex = hookmetamethod(game, "__index", function(self, index)
            if self == LocalPlayer then
                if index == "UserId"
                    or index == "userId"
                    or index == "CharacterAppearanceId"
                    or index == "AppearanceId" then
                    return TargetID
                end
            end
            return oldIndex(self, index)
        end)
        IdBtn.Text = "تم التثبيت!"
        task.wait(1)
        IdBtn.Text = "Fix Appearance ID"
    end
end)

if not getgenv().TimeHooked then
    getgenv().OriginalTime = time
    getgenv().OriginalWorkspace = workspace
    getgenv().AddedSeconds = 0
    time = function()
        return getgenv().OriginalTime() + getgenv().AddedSeconds
    end
    local fakeWorkspace = setmetatable({}, {
        __index = function(t, key)
            if key == "DistributedGameTime" then
                return getgenv().OriginalWorkspace.DistributedGameTime
                    + getgenv().AddedSeconds
            end
            return getgenv().OriginalWorkspace[key]
        end,
        __newindex = function(t, key, value)
            getgenv().OriginalWorkspace[key] = value
        end
    })
    getgenv().workspace = fakeWorkspace
    pcall(function()
        getgenv().game.Workspace = fakeWorkspace
    end)
    getgenv().TimeHooked = true
end

