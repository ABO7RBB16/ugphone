    end
end)

Players.PlayerRemoving:Connect(function(player)
    if selectedPlayer == player then
        selectedPlayer = nil
        SelectPlayerBtn.Text = "اختر لاعب من السيرفر..."
    end
    if PlayersHolder.Visible then
        task.defer(refreshPlayerList)
    end
end)

